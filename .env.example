# Copy to .env (never commit .env). All values below are placeholders.
DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:5432/ledger
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Only test-mode keys (sk_test_/rk_test_) are accepted; live keys are refused.
STRIPE_API_KEY=sk_test_replace_me
SHEET_TIMEZONE=America/Los_Angeles
# Required by the sheet sync only: "csv" (offline; sample data!) or "google" (real Google Sheets, UNVERIFIED)
# SHEET_SOURCE=csv
SHEET_CSV_PATH=sample_data/sheet.csv
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=
GOOGLE_SERVICE_ACCOUNT_JSON=
SYNC_BATCH_SIZE=500
RECONCILE_LOOKBACK_HOURS=72
# Bearer token required by GET /donations and GET /sync-runs.
API_TOKEN=replace-me
# Set to "true" ONLY for local demos: disables the API token requirement.
ALLOW_UNAUTHENTICATED_API=false
